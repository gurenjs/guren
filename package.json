{
  "name": "guren-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gurenjs/guren.git"
  },
  "homepage": "https://github.com/gurenjs/guren#readme",
  "bugs": {
    "url": "https://github.com/gurenjs/guren/issues"
  },
  "scripts": {
    "build": "bun run build:testing && bun run build:orm && bun run build:server && bun run build:cli && bun run build:core && bun run build:create-app && bun run build:inertia",
    "build:routes": "bun run --cwd examples/blog routes:types",
    "build:testing": "bun run --cwd packages/testing build",
    "build:core": "bun run --cwd packages/core build",
    "build:server": "bun run --cwd packages/server build",
    "build:orm": "bun run --cwd packages/orm build",
    "build:cli": "bun run --cwd packages/cli build",
    "build:create-app": "bun run --cwd packages/create-app build",
    "build:inertia": "bun run --cwd packages/inertia-client build",
    "audit:core-first": "bun run ./scripts/smoke/core-first-audit.ts",
    "audit:contracts": "bun run ./scripts/smoke/contract-audit.ts",
    "audit:feature-runtime": "bun run ./scripts/smoke/feature-runtime-audit.ts",
    "audit:bundle-budgets": "bun run ./scripts/smoke/build-budget.ts",
    "audit:starter-template": "bun run ./scripts/smoke/starter-template-audit.ts",
    "audit:docs": "bun run ./scripts/smoke/docs-audit.ts",
    "smoke:starter": "bun run ./scripts/smoke/fresh-app.ts",
    "smoke:starter:packed": "GUREN_SMOKE_INSTALL_MODE=packed bun run ./scripts/smoke/fresh-app.ts",
    "changeset": "changeset",
    "version-packages": "changeset version && bun install",
    "release": "bun run build && changeset publish",
    "test:bun": "bun test packages/server packages/orm packages/core packages/inertia-client packages/create-app packages/cli",
    "test:examples": "bun run --cwd examples/blog test && bun run --cwd examples/api test && bun run --cwd web test",
    "test": "bun run test:bun && bun run test:examples",
    "typecheck": "tsc --noEmit && bun run typecheck:blog",
    "typecheck:blog": "bun run --cwd examples/blog typecheck",
    "dev": "bun run --cwd examples/blog dev",
    "db:migrate": "bun run --cwd examples/blog db:migrate",
    "db:seed": "bun run --cwd examples/blog db:seed",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres"
  },
  "workspaces": [
    "packages/*",
    "examples/*",
    "web"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "bun-types": "^1.3.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.3",
    "vite": "^8.0.0",
    "zod": "^4.1.5"
  }
}
