{
  "name": "guren-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gurenjs/guren.git"
  },
  "homepage": "https://github.com/gurenjs/guren#readme",
  "bugs": {
    "url": "https://github.com/gurenjs/guren/issues"
  },
  "scripts": {
    "build": "bun run ./scripts/build-packages.ts",
    "build:clean": "bun run ./scripts/build-packages.ts --clean",
    "build:list": "bun run ./scripts/build-packages.ts --list",
    "build:routes": "bun run --cwd examples/blog routes:types",
    "build:testing": "bun run --cwd packages/testing build",
    "build:core": "bun run --cwd packages/core build",
    "build:server": "bun run --cwd packages/server build",
    "build:orm": "bun run --cwd packages/orm build",
    "build:cli": "bun run --cwd packages/cli build",
    "build:openapi": "bun run --cwd packages/openapi build",
    "build:create-app": "bun run --cwd packages/create-app build",
    "build:inertia": "bun run --cwd packages/inertia-client build",
    "audit:core-first": "bun run ./scripts/smoke/core-first-audit.ts",
    "audit:contracts": "bun run ./scripts/smoke/contract-audit.ts",
    "audit:feature-runtime": "bun run ./scripts/smoke/feature-runtime-audit.ts",
    "audit:bundle-budgets": "bun run ./scripts/smoke/build-budget.ts --max-kb 600",
    "audit:starter-template": "bun run ./scripts/smoke/starter-template-audit.ts",
    "audit:docs": "bun run ./scripts/smoke/docs-audit.ts",
    "audit:deps": "bun run ./scripts/smoke/dependency-audit.ts",
    "smoke:starter": "bun run ./scripts/smoke/fresh-app.ts",
    "smoke:starter:api": "GUREN_SMOKE_BLUEPRINT=api bun run ./scripts/smoke/fresh-app.ts",
    "smoke:starter:blog": "GUREN_SMOKE_BLUEPRINT=blog bun run ./scripts/smoke/fresh-app.ts",
    "smoke:starter:worker": "GUREN_SMOKE_BLUEPRINT=worker bun run ./scripts/smoke/fresh-app.ts",
    "smoke:starter:packed": "GUREN_SMOKE_INSTALL_MODE=packed bun run ./scripts/smoke/fresh-app.ts",
    "smoke:starter:npm": "GUREN_SMOKE_INSTALL_MODE=npm bun run ./scripts/smoke/fresh-app.ts",
    "smoke:starter:npm:api": "GUREN_SMOKE_INSTALL_MODE=npm GUREN_SMOKE_BLUEPRINT=api bun run ./scripts/smoke/fresh-app.ts",
    "smoke:starter:npm:blog": "GUREN_SMOKE_INSTALL_MODE=npm GUREN_SMOKE_BLUEPRINT=blog bun run ./scripts/smoke/fresh-app.ts",
    "smoke:upgrade-existing-app": "bun run ./scripts/smoke/upgrade-existing-app.ts",
    "smoke:golden-path": "bash ./scripts/smoke-golden-path.sh",
    "smoke:golden-path:postgres": "GUREN_SMOKE_DB=postgres bash ./scripts/smoke-golden-path.sh",
    "smoke:golden-path:mysql": "GUREN_SMOKE_DB=mysql bash ./scripts/smoke-golden-path.sh",
    "changeset": "changeset",
    "sync:template-deps": "bun run ./scripts/sync-template-deps.ts",
    "audit:template-deps": "bun run ./scripts/sync-template-deps.ts --check",
    "version-packages": "changeset version && bun run ./scripts/sync-template-deps.ts --release && bun install",
    "release": "bun run build && changeset publish",
    "test:bun": "bun run ./scripts/test-packages.ts",
    "test:bun:list": "bun run ./scripts/test-packages.ts --list",
    "test:testing": "bun run --cwd packages/testing test",
    "test:examples": "bun run --cwd examples/blog test && bun run --cwd examples/api test && bun run --cwd web test",
    "test": "bun run test:bun && bun run test:examples",
    "typecheck": "tsc --noEmit && bun run typecheck:blog && bun run typecheck:api",
    "typecheck:blog": "bun run --cwd examples/blog typecheck",
    "typecheck:api": "bun run --cwd examples/api typecheck",
    "dev": "bun run --cwd examples/blog dev",
    "db:migrate": "GUREN_QUIET_DUPLICATE_ORM=1 bun run --cwd examples/blog db:migrate",
    "db:seed": "GUREN_QUIET_DUPLICATE_ORM=1 bun run --cwd examples/blog db:seed",
    "db:up": "docker compose up -d postgres",
    "db:up:mysql": "docker compose up -d mysql",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "bench": "bun run ./scripts/benchmarks/run-benchmarks.ts",
    "audit:vercel-build": "bun run ./scripts/smoke/vercel-build-audit.ts examples/blog"
  },
  "workspaces": [
    "packages/*",
    "examples/*",
    "web"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "bun-types": "^1.3.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "vite": "^8.2.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "qs": "^6.15.2",
    "hono": "^4.12.29",
    "@hono/node-server": "^2.0.5",
    "axios": "^1.17.0",
    "follow-redirects": "^1.16.0",
    "lodash-es": "^4.18.1",
    "postcss": "^8.5.18",
    "ip-address": "^10.2.0",
    "fast-uri": "^3.1.3",
    "path-to-regexp": "^8.4.0",
    "body-parser": "^2.3.0",
    "ws": "^8.20.1",
    "form-data": "^4.0.6"
  }
}
