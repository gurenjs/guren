node_modules/
**/dist/
.env
**/.DS_Store
**/*.log
# Ignore TypeScript incremental build info files
*.tsbuildinfo

### Wrangler ###
.wrangler/
.env*
!.env.example
.dev.vars*
!.dev.vars.example

.agents

# Artifacts from running a scaffolding template in place. The templates carry
# their own rules as `_gitignore` (npm strips files named `.gitignore` from
# published tarballs), so those no longer apply to this repo.
packages/create-app/templates/*/data/
packages/create-app/templates/*/public/assets/
packages/create-app/templates/*/.guren/ssr/
packages/create-app/templates/*/types/generated/routes.d.ts

# Benchmark outputs
benchmarks.json
benchmark-history.json
# serena (MCP) tool-local state — regenerated on startup
.serena/
