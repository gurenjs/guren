# Local development uses SQLite; production runs on Cloudflare D1 through the
# DB binding in wrangler.jsonc (no connection string).
SQLITE_DATABASE_PATH=./data/guren.db

# GitHub OAuth app for the blog admin (all three required to enable login).
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URI=http://localhost:3000/auth/github/callback

# Numeric GitHub account id allowed to sign in. Unset means "any account" in
# local development and "no account" in production, so sign-in is refused
# outright if it is missing from the deployed environment.
BLOG_ADMIN_GITHUB_ID=
