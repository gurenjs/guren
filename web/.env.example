DATABASE_URL=postgres://guren:guren@localhost:54322/guren

# GitHub OAuth app for the blog admin (all three required to enable login).
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URI=http://localhost:3000/auth/github/callback

# Numeric GitHub account id allowed to sign in. When unset, any GitHub
# account is accepted (local development only — always set in production).
BLOG_ADMIN_GITHUB_ID=
