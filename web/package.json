{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "codegen": "cd .. && bun packages/cli/src/bin.ts codegen --app web --routes routes/web.ts --out types/generated/routes.d.ts --pages resources/js/pages --pagesOut .guren/pages.gen.ts --force",
    "routes:types": "bun run codegen",
    "dev": "bun run codegen && bun run dev:server",
    "dev:server": "bun bin/serve.ts",
    "typecheck": "bunx tsc --noEmit",
    "test": "bunx vitest run",
    "build": "bun run codegen && bunx vite build && bunx vite build --ssr",
    "preview": "NODE_ENV=production bun bin/serve.ts",
    "db:make": "bunx guren make:migration",
    "db:migrate": "bunx guren db:migrate",
    "db:seed": "bunx guren db:seed"
  },
  "dependencies": {
    "@guren/cli": "workspace:*",
    "@guren/core": "workspace:*",
    "@guren/inertia-client": "workspace:*",
    "@guren/orm": "workspace:*",
    "@guren/testing": "workspace:*",
    "@inertiajs/core": "^2.3.18",
    "@inertiajs/react": "^2.3.18",
    "drizzle-orm": "0.44.7",
    "marked": "^15.0.11",
    "marked-highlight": "^2.2.3",
    "postgres": "^3.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shiki": "^3.15.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "0.27.0",
    "typescript": "^5.4.0",
    "@vitejs/plugin-react": "^6.0.0",
    "vite": "^8.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "tailwindcss": "^4.2.2",
    "vitest": "^2.1.3"
  }
}
