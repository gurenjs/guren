{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "noEmit": true,
    // TypeScript 7 defaults rootDir to the config directory; `paths` below pull
    // sibling packages into every program, so anchor it at the repo root.
    "rootDir": ".",
    "allowImportingTsExtensions": true,
    "types": [
      "bun-types"
    ],
    "paths": {
      "@guren/core": [
        "./packages/core/src/index.ts"
      ],
      "@guren/core/*": [
        "./packages/core/src/*"
      ],
      "@guren/server": [
        "./packages/server/src/index.ts"
      ],
      "@guren/server/*": [
        "./packages/server/src/*"
      ],
      "@guren/orm": [
        "./packages/orm/src/index.ts"
      ],
      "@guren/orm/*": [
        "./packages/orm/src/*"
      ],
      "@guren/cli": [
        "./packages/cli/src/index.ts"
      ],
      "@guren/cli/*": [
        "./packages/cli/src/*"
      ],
      "@guren/cli/vite": [
        "./packages/cli/src/vite/index.ts"
      ],
      "@guren/openapi": [
        "./packages/openapi/src/index.ts"
      ],
      "@guren/openapi/*": [
        "./packages/openapi/src/*"
      ],
      "@guren/inertia-client": [
        "./packages/inertia-client/src/index.ts"
      ],
      "@guren/inertia-client/*": [
        "./packages/inertia-client/src/*"
      ],
      "@guren/plugin-vercel": [
        "./packages/plugin-vercel/src/index.ts"
      ],
      "@guren/plugin-vercel/*": [
        "./packages/plugin-vercel/src/*"
      ],
      "@guren/testing": [
        "./packages/testing/src/index.ts"
      ],
      "@guren/testing/*": [
        "./packages/testing/src/*"
      ],
      "vite": [
        "./node_modules/vite"
      ],
      "vite/*": [
        "./node_modules/vite/*"
      ]
    }
  },
  "include": [
    "packages/**/*",
    "types/**/*"
  ],
  "exclude": [
    "packages/create-app/templates",
    "packages/cli/templates/scaffold",
    "packages/cli/tests/fixtures/scaffold-typecheck"
  ]
}
