{
  "extends": ["./tsconfig.json", "../../tsconfig.build-base.json"],
  "compilerOptions": {
    // Declarations come from tsc here, not from tsdown (see the build
    // script); this is the one config in the workspace that emits.
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts"]
}
