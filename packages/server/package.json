    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/client-sqs": {
      "optional": true
    },
    "@aws-sdk/s3-request-presigner": {
      "optional": true
    },
    "@guren/inertia-client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/ioredis": "^5.0.0",
    "@types/node": "^20.14.10",
    "@types/nodemailer": "^8.0.1",
