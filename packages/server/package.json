    "./lambda": {
      "types": "./dist/lambda/index.d.ts",
      "default": "./dist/lambda/index.js"
    },
    "./redis": {
      "types": "./dist/redis/index.d.ts",
      "default": "./dist/redis/index.js"
    },
    "./support/expiry": {
      "types": "./dist/support/expiry.d.ts",
      "default": "./dist/support/expiry.js"
    }
  },
  "scripts": {
    "build": "bun --bun tsdown && tsc -p tsconfig.build.json && bun ../../scripts/fix-dts-extensions.ts dist",
    "dev": "bun --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@guren/orm": "^2.6.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chalk": "^5.3.0",
    "consola": "^3.4.2",
    "figlet": "^1.7.0",
    "hono": "^4.12.29",
    "ioredis": "^5.11.1",
    "nodemailer": "^9.0.1"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/client-sqs": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "vite": ">=7.0.0",
    "@guren/inertia-client": "^1.0.0"
  },
