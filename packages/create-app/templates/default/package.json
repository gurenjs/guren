{
  "name": "guren-app-placeholder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "codegen": "bunx guren codegen --force",
    "dev": "bun run codegen && GUREN_MCP=1 GUREN_DOCS=1 bun run dev:server",
    "dev:server": "bun --hot bin/serve.ts",
    "console": "bun bin/console.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun run codegen && bunx vite build",
    "preview": "NODE_ENV=production bun bin/serve.ts",
    "db:make": "bunx guren make:migration",
    "db:migrate": "bunx guren db:migrate",
    "db:reset": "bunx guren db:reset",
    "db:status": "bunx guren db:status",
    "db:seed": "bunx guren db:seed"
  },
  "dependencies": {
    "@guren/cli": "^2.11.0",
    "@guren/core": "^1.10.0",
    "@guren/inertia-client": "^1.1.2",
    "@guren/orm": "^2.6.1",
    "@inertiajs/react": "^3.6.1",
    "drizzle-orm": "1.0.0-rc.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@guren/testing": "^1.6.3",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "bun-types": "^1.3.1",
    "drizzle-kit": "1.0.0-rc.4",
    "mermaid": "^11.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.4.0",
    "vite": "^8.0.0"
  }
}
