{
  "name": "guren-app-placeholder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "codegen": "bunx guren codegen --routes routes/web.ts --out types/generated/routes.d.ts --force",
    "dev": "bun run codegen && bun run dev:server",
    "dev:server": "bun bin/serve.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun run codegen && bunx vite build",
    "preview": "NODE_ENV=production bun bin/serve.ts",
    "db:make": "bunx guren make:migration",
    "db:migrate": "bunx guren db:migrate",
    "db:seed": "bunx guren db:seed"
  },
  "dependencies": {
    "@guren/cli": "^0.2.0-alpha.7",
    "@guren/core": "^0.2.0-alpha.7",
    "@guren/inertia-client": "^0.2.0-alpha.7",
    "@guren/orm": "^0.2.0-alpha.7",
    "@inertiajs/react": "^2.2.15",
    "drizzle-orm": "0.44.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bun-types": "^1.3.1",
    "drizzle-kit": "0.27.0",
    "typescript": "^5.4.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0",
    "@tailwindcss/vite": "^4.1.16",
    "tailwindcss": "^4.1.16"
  }
}
