{
  "name": "guren-app-placeholder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run codegen && bun run dev:server",
    "dev:server": "bun bin/serve.ts",
    "codegen": "bunx guren codegen --routes routes/api.ts --force",
    "typecheck": "tsc --noEmit",
    "db:make": "bunx guren make:migration",
    "db:migrate": "bunx guren db:migrate",
    "db:seed": "bunx guren db:seed",
    "build": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@guren/cli": "^1.0.0-rc.11",
    "@guren/core": "^1.0.0-rc.11",
    "@guren/orm": "^1.0.0-rc.11",
    "drizzle-orm": "1.0.0-beta.18-7eb39f0"
  },
  "devDependencies": {
    "bun-types": "^1.3.1",
    "drizzle-kit": "1.0.0-beta.18-7eb39f0",
    "mysql2": "^3.11.3",
    "postgres": "^3.4.3",
    "typescript": "^5.4.0"
  }
}
