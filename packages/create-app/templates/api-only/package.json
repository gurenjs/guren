{
  "name": "guren-app-placeholder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run codegen && GUREN_MCP=1 GUREN_DOCS=1 bun run dev:server",
    "dev:server": "bun --hot bin/serve.ts",
    "console": "bun bin/console.ts",
    "codegen": "bunx guren codegen --routes routes/api.ts --force",
    "typecheck": "tsc --noEmit",
    "db:make": "bunx guren make:migration",
    "db:migrate": "bunx guren db:migrate",
    "db:reset": "bunx guren db:reset",
    "db:status": "bunx guren db:status",
    "db:seed": "bunx guren db:seed",
    "build": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@guren/cli": "^2.12.0",
    "@guren/core": "^1.11.0",
    "@guren/orm": "^2.6.1",
    "drizzle-orm": "1.0.0-rc.4"
  },
  "devDependencies": {
    "@guren/testing": "^1.7.0",
    "bun-types": "^1.3.1",
    "drizzle-kit": "1.0.0-rc.4",
    "typescript": "^5.4.0"
  }
}
