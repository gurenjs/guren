{
  "name": "guren-app-placeholder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run codegen && bun run dev:server",
    "dev:server": "bun bin/serve.ts",
    "codegen": "bunx guren codegen --routes routes/api.ts --force",
    "typecheck": "tsc --noEmit",
    "db:make": "bunx guren make:migration",
    "db:migrate": "bunx guren db:migrate",
    "db:seed": "bunx guren db:seed",
    "test": "bun test"
  },
  "dependencies": {
    "@guren/cli": "^0.2.0-alpha.7",
    "@guren/core": "^0.2.0-alpha.7",
    "@guren/orm": "^0.2.0-alpha.7"
  },
  "devDependencies": {
    "bun-types": "^1.3.1",
    "drizzle-kit": "0.27.0",
    "typescript": "^5.4.0"
  }
}
