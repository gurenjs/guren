{
  "name": "@guren/testing",
  "version": "1.14.1",
  "description": "Testing utilities for Guren applications: TestApp with HTTP and Inertia assertions, plus auth, mail, queue and event fakes for bun:test.",
  "keywords": [
    "guren",
    "bun",
    "typescript",
    "fullstack",
    "framework",
    "testing",
    "bun-test"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gurenjs/guren",
    "directory": "packages/testing"
  },
  "homepage": "https://github.com/gurenjs/guren#readme",
  "bugs": {
    "url": "https://github.com/gurenjs/guren/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "default": "./dist/vitest.js"
    }
  },
  "scripts": {
    "build": "bun --bun tsdown",
    "dev": "bun --bun tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "peerDependencies": {
    "@guren/core": ">=1.8.0",
    "@guren/plugin-ai": ">=0.1.0",
    "@guren/server": ">=2.26.0",
    "@inertiajs/react": "^3.6.1",
    "@testing-library/react": "^14.0.0 || ^15.0.0 || ^16.0.0",
    "ai": "^7.0.106",
    "hono": "^4.13.7",
    "react": "^18.0.0 || ^19.0.0",
    "vitest": "^3.2.6 || ^4.1.11 || ^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "vitest": "^5.0.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "peerDependenciesMeta": {
    "@guren/core": {
      "optional": true
    },
    "vitest": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@testing-library/react": {
      "optional": true
    },
    "@inertiajs/react": {
      "optional": true
    },
    "@guren/plugin-ai": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  }
}
