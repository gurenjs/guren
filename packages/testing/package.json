{
  "name": "@guren/testing",
  "version": "1.3.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gurenjs/guren",
    "directory": "packages/testing"
  },
  "homepage": "https://github.com/gurenjs/guren#readme",
  "bugs": {
    "url": "https://github.com/gurenjs/guren/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "default": "./dist/vitest.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "peerDependencies": {
    "@guren/server": ">=1.0.0",
    "@inertiajs/react": "^3.6.1",
    "@testing-library/react": "^14.0.0 || ^15.0.0 || ^16.0.0",
    "hono": "^4.12.29",
    "react": "^18.0.0 || ^19.0.0",
    "vitest": "^3.2.6"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "vitest": "^3.2.6",
    "tsup": "^8.5.0",
    "typescript": "^5.4.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@testing-library/react": {
      "optional": true
    },
    "@inertiajs/react": {
      "optional": true
    }
  }
}
