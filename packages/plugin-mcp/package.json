{
  "name": "@guren/plugin-mcp",
  "version": "0.6.0",
  "description": "Production MCP endpoint for Guren applications: serves the agent tools derived from routes that declare .agent() over the Model Context Protocol, with rate limiting.",
  "keywords": [
    "guren",
    "bun",
    "typescript",
    "fullstack",
    "framework",
    "mcp",
    "model-context-protocol",
    "ai-agents"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gurenjs/guren",
    "directory": "packages/plugin-mcp"
  },
  "homepage": "https://github.com/gurenjs/guren#readme",
  "bugs": {
    "url": "https://github.com/gurenjs/guren/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "gurenPlugin": {
    "compatibility": ">=1.14.0 <2.0.0"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./oauth": {
      "types": "./dist/oauth.d.ts",
      "default": "./dist/oauth.js"
    }
  },
  "scripts": {
    "build": "bun --bun tsdown",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@guren/core": "^1.19.0",
    "@modelcontextprotocol/server": "^2.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^20.14.10",
    "hono": "^4.13.7",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "zod": "^4"
  }
}
