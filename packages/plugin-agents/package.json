{
  "name": "@guren/plugin-agents",
  "version": "0.2.0",
  "type": "module",
  "description": "Durable agents for Guren applications: hosts Cloudflare Agents SDK Durable Objects that call the app's own agent tools through the RFC 0017 invocation pipeline.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gurenjs/guren",
    "directory": "packages/plugin-agents"
  },
  "homepage": "https://github.com/gurenjs/guren#readme",
  "bugs": {
    "url": "https://github.com/gurenjs/guren/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "gurenPlugin": {
    "compatibility": ">=1.14.0 <2.0.0"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "default": "./dist/agent.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    }
  },
  "scripts": {
    "build": "bun --bun tsdown",
    "test": "bun test && bun run test:workers",
    "test:workers": "bun tests/workers/build-fixture.ts && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@guren/core": "^1.14.0",
    "agents": "^0.22.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.3",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@guren/plugin-cloudflare": "workspace:*",
    "@guren/plugin-mcp": "^0.4.0",
    "@types/node": "^20.14.10",
    "hono": "^4.11.7",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.128.0"
  }
}
