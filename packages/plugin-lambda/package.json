{
  "name": "@guren/plugin-lambda",
  "version": "0.2.1",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gurenjs/guren",
    "directory": "packages/plugin-lambda"
  },
  "homepage": "https://github.com/gurenjs/guren#readme",
  "bugs": {
    "url": "https://github.com/gurenjs/guren/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "gurenPlugin": {
    "compatibility": ">=1.0.0 <2.0.0",
    "commands": {
      "entry": "./dist/commands.js",
      "names": [
        "lambda:build"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cdk": {
      "types": "./dist/cdk/index.d.ts",
      "default": "./dist/cdk/index.js"
    }
  },
  "scripts": {
    "build": "bun --bun tsdown",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@guren/core": "^1.8.1",
    "citty": "^0.1.6"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.156.0",
    "constructs": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "aws-cdk-lib": {
      "optional": true
    },
    "constructs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "aws-cdk-lib": "^2.262.1",
    "constructs": "^10.7.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  }
}
