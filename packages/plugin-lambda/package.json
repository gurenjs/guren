{
  "name": "@guren/plugin-lambda",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gurenjs/guren",
    "directory": "packages/plugin-lambda"
  },
  "homepage": "https://github.com/gurenjs/guren#readme",
  "bugs": {
    "url": "https://github.com/gurenjs/guren/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "gurenPlugin": {
    "compatibility": ">=1.0.0 <2.0.0",
    "commands": {
      "entry": "./dist/commands.js",
      "names": [
        "lambda:build"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@guren/core": "^1.3.0",
    "citty": "^0.1.6"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsup": "^8.5.0",
    "typescript": "^5.4.0"
  }
}
