{
  "name": "@guren/cli",
  "version": "2.27.0",
  "description": "CLI for the Guren framework: scaffolding (make:*, add), migrations, codegen, and the check, audit and gate commands a coding agent runs to verify its work.",
  "keywords": [
    "guren",
    "bun",
    "typescript",
    "fullstack",
    "framework",
    "cli",
    "scaffold",
    "codegen",
    "ai-agents",
    "claude-code"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gurenjs/guren",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/gurenjs/guren#readme",
  "bugs": {
    "url": "https://github.com/gurenjs/guren/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "templates",
    "assets"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bin": {
      "default": "./dist/bin.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    },
    "./arch": {
      "types": "./dist/arch/index.d.ts",
      "default": "./dist/arch/index.js"
    },
    "./oxlint": {
      "default": "./dist/oxlint/index.js"
    }
  },
  "bin": {
    "guren": "./dist/bin.js"
  },
  "scripts": {
    "build": "bun --bun tsdown && bun scripts/build-plan-page.ts",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "typecheck:templates": "bun ../../scripts/check-template-configs.ts"
  },
  "dependencies": {
    "@babel/parser": "^7.24.7",
    "@guren/orm": "^2.12.0",
    "@guren/server": "^2.26.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "citty": "^0.1.6",
    "consola": "^3.4.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@guren/openapi": ">=1.3.0",
    "@guren/plugin-ai": ">=0.2.0",
    "oxlint": "~1.81.0",
    "vite": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "@guren/openapi": {
      "optional": true
    },
    "@guren/plugin-ai": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.54",
    "@ai-sdk/openai": "^4.0.67",
    "@babel/types": "^7.29.0",
    "@inertiajs/react": "^3.6.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^20.14.10",
    "@types/react": "^19.0.0",
    "ai": "^7.0.106",
    "hono": "^4.13.7",
    "react": "^19.0.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "@guren/core": "^1.21.0"
  }
}
