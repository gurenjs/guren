{
  "name": "@guren/cli",
  "version": "2.10.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gurenjs/guren",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/gurenjs/guren#readme",
  "bugs": {
    "url": "https://github.com/gurenjs/guren/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "templates",
    "assets"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bin": {
      "default": "./dist/bin.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    },
    "./arch": {
      "types": "./dist/arch/index.d.ts",
      "default": "./dist/arch/index.js"
    }
  },
  "bin": {
    "guren": "./dist/bin.js"
  },
  "scripts": {
    "build": "bun --bun tsdown",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "typecheck:templates": "tsc -p tsconfig.templates.json && tsc -p tsconfig.templates-attachments.json && tsc -p tsconfig.templates-mail.json"
  },
  "dependencies": {
    "@babel/parser": "^7.24.7",
    "@guren/core": "^1.9.0",
    "@guren/orm": "^2.6.1",
    "@guren/server": "^2.11.0",
    "citty": "^0.1.6",
    "consola": "^3.4.2"
  },
  "peerDependencies": {
    "@guren/openapi": ">=1.3.0",
    "vite": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "@guren/openapi": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/types": "^7.29.0",
    "@inertiajs/react": "^3.6.1",
    "@types/node": "^20.14.10",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "zod": "^4.4.3"
  }
}
