{
  "name": "@guren/orm",
  "version": "2.4.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gurenjs/guren",
    "directory": "packages/orm"
  },
  "homepage": "https://github.com/gurenjs/guren#readme",
  "bugs": {
    "url": "https://github.com/gurenjs/guren/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle.d.ts",
      "default": "./dist/drizzle.js"
    },
    "./drizzle/pg": {
      "types": "./dist/drizzle/pg.d.ts",
      "default": "./dist/drizzle/pg.js"
    },
    "./drizzle/mysql": {
      "types": "./dist/drizzle/mysql.d.ts",
      "default": "./dist/drizzle/mysql.js"
    },
    "./drizzle/sqlite": {
      "types": "./dist/drizzle/sqlite.d.ts",
      "default": "./dist/drizzle/sqlite.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "drizzle-orm": "1.0.0-rc.4"
  },
  "peerDependencies": {
    "@aws-sdk/client-rds-data": "^3.0.0",
    "mysql2": "^3.11.3",
    "postgres": "^3.4.3"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-rds-data": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "postgres": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-rds-data": "^3.0.0",
    "@types/node": "^20.14.10",
    "mysql2": "^3.11.3",
    "postgres": "^3.4.3",
    "tsup": "^8.5.0",
    "typescript": "^5.4.0"
  }
}
