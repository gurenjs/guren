# Signs sessions and CSRF, and encrypts the agent's pending-approval ledger.
# Generate one with: bun -e "console.log('base64:' + Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('base64'))"
APP_KEY=base64:REPLACE_ME

# Where the local bun:sqlite database lives. D1 replaces it on Workers.
SQLITE_DATABASE_PATH=./data/agents.db

# Anthropic API key for config/ai.ts. Unset, the app boots and the first prompt fails naming it.
ANTHROPIC_API_KEY=

# TypeSafe AI key for the `typesafe` provider (Jev), used by POST /tickets/:id/triage.
# Unset, the app boots and the first triage fails naming it.
TYPESAFE_AI_API_KEY=
