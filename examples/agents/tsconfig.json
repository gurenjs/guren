{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "types": [
      "bun-types",
      "@cloudflare/workers-types",
      "vite/client"
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@guren/cli": [
        "../../packages/cli/src/index.ts"
      ],
      "@guren/cli/*": [
        "../../packages/cli/src/*"
      ],
      "@guren/core": [
        "../../packages/core/src/index.ts"
      ],
      "@guren/core/*": [
        "../../packages/core/src/*"
      ],
      "@guren/server": [
        "../../packages/server/src/index.ts"
      ],
      "@guren/server/*": [
        "../../packages/server/src/*"
      ],
      "@guren/orm": [
        "../../packages/orm/src/index.ts"
      ],
      "@guren/orm/*": [
        "../../packages/orm/src/*"
      ],
      "@guren/plugin-agents": [
        "../../packages/plugin-agents/src/index.ts"
      ],
      "@guren/plugin-agents/*": [
        "../../packages/plugin-agents/src/*"
      ],
      "@guren/plugin-cloudflare": [
        "../../packages/plugin-cloudflare/src/index.ts"
      ],
      "@guren/plugin-cloudflare/*": [
        "../../packages/plugin-cloudflare/src/*"
      ],
      "@guren/inertia-client": [
        "../../packages/inertia-client/src/index.ts"
      ],
      "@guren/inertia-client/*": [
        "../../packages/inertia-client/src/*"
      ]
    }
  },
  "include": [
    ".guren/**/*",
    "src/**/*",
    "app/**/*",
    "bin/**/*",
    "routes/**/*",
    "config/**/*",
    "tests/**/*",
    "db/**/*",
    "resources/js/**/*",
    "guren.arch.ts",
    "vite.config.ts"
  ],
  "exclude": []
}
