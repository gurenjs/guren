{
  "name": "@guren/example-agents",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot bin/serve.ts",
    "build": "bun ../../packages/cli/src/bin.ts codegen --app . --routes routes/api.ts --out types/generated/routes.d.ts --force",
    "test": "bun test tests",
    "typecheck": "tsc --noEmit",
    "check": "bun ../../packages/cli/src/bin.ts check",
    "audit": "bun ../../packages/cli/src/bin.ts audit --routes routes/api.ts",
    "tool:list": "bun ../../packages/cli/src/bin.ts tool:list --routes routes/api.ts",
    "db:make": "bun ../../packages/cli/src/bin.ts make:migration",
    "db:migrate": "bun ../../packages/cli/src/bin.ts db:migrate",
    "db:seed": "bun ../../packages/cli/src/bin.ts db:seed",
    "cloudflare:build": "bun ../../packages/cli/src/bin.ts cloudflare:build",
    "db:seed:d1": "bun db/seed-d1.ts"
  },
  "dependencies": {
    "@guren/cli": "workspace:*",
    "@guren/core": "workspace:*",
    "@guren/orm": "workspace:*",
    "@guren/plugin-agents": "workspace:*",
    "@guren/plugin-cloudflare": "workspace:*",
    "@guren/testing": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4",
    "zod": "^4.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "drizzle-kit": "1.0.0-rc.4",
    "typescript": "^7.0.2",
    "wrangler": "^4.118.0"
  }
}
