{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "types": [
      "bun-types",
      "vitest/globals",
      "@testing-library/jest-dom",
      "vite/client"
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@guren/core": [
        "../../packages/core/src/index.ts"
      ],
      "@guren/core/*": [
        "../../packages/core/src/*"
      ],
      "@guren/server": [
        "../../packages/server/src/index.ts"
      ],
      "@guren/server/*": [
        "../../packages/server/src/*"
      ],
      "@guren/orm": [
        "../../packages/orm/src/index.ts"
      ],
      "@guren/orm/*": [
        "../../packages/orm/src/*"
      ],
      "@guren/inertia-client": [
        "../../packages/inertia-client/src/index.ts"
      ],
      "@guren/inertia-client/*": [
        "../../packages/inertia-client/src/*"
      ],
      "@guren/testing": [
        "../../packages/testing/src/index.ts"
      ],
      "@guren/testing/*": [
        "../../packages/testing/src/*"
      ]
    }
  },
  "include": [
    ".guren/**/*",
    "src/**/*",
    "app/**/*",
    "bin/**/*",
    "config/**/*",
    "db/**/*",
    "routes/**/*",
    "resources/js/**/*",
    "types/**/*",
    "tests/**/*",
    "drizzle.config.ts"
  ],
  "exclude": ["e2e/**/*", "playwright.config.ts"]
}
