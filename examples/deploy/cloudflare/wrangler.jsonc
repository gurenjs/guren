{
  "name": "my-guren-app",
  "main": ".cloudflare/worker.js",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],

  // Generated by `guren cloudflare:build` on the first run. These entries
  // keep development-only modules out of the bundle: they sit in every
  // app's module graph behind dev-time branches, and bundlers follow those
  // imports regardless of the branch.
  "alias": {
    "bun:sqlite": "./.cloudflare/stub-bun-sqlite.js",
    "vite": "./.cloudflare/stub-vite.js",
    "@guren/cli": "./.cloudflare/stub-guren-cli.js",
    "@modelcontextprotocol/sdk/server/mcp.js": "./.cloudflare/stub-mcp-server.js",
    "@modelcontextprotocol/sdk/server/webStandardStreamableHttp.js": "./.cloudflare/stub-mcp-transport.js"
  },

  // Substituted at build time. workerd leaves `import.meta.url` undefined,
  // which breaks both the SSR bundle's CommonJS interop and any
  // `new URL(..., import.meta.url)` in config — both at module scope, so the
  // worker would die before serving a request.
  "define": {
    "process.env.NODE_ENV": "\"production\"",
    "import.meta.url": "\"file:///worker.js\""
  },

  "assets": {
    "directory": ".cloudflare/assets"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "my-guren-app",
      "database_id": "<run `wrangler d1 create my-guren-app` and paste the id>",
      // Regenerated on every build — apply migrations after building.
      "migrations_dir": ".cloudflare/d1-migrations"
    }
  ],

  // Workers keeps no logs by default, which makes a production failure very
  // hard to trace.
  "observability": {
    "enabled": true
  },

  // Uncomment once the domain's DNS is on Cloudflare. Any existing record
  // for the hostname has to be removed first, or the deploy cannot claim it.
  // "routes": [
  //   { "pattern": "example.com", "custom_domain": true },
  //   { "pattern": "www.example.com", "custom_domain": true }
  // ],

  "vars": {
    "NODE_ENV": "production"
  }
}
